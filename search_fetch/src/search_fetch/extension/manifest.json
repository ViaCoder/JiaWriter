{
  "manifest_version": 3,
  "name": "search_fetch bridge",
  "description": "Opens pages for WriterAgent's search_fetch in a dedicated window of this Chrome and returns their content to the local sf process.",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
