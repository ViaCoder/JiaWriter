{
  "manifest_version": 3,
  "name": "JiaWriter",
  "description": "JiaWriter 写作助手：在 Chrome 的专用窗口里检索和阅读网页。",
  "version": "2.4.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "alarms",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
